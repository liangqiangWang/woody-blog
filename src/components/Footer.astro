---
import Icons from './Icons.astro';
import { SITE } from '../consts';

const base = SITE.base;
const year = 2026;
---
<footer class="footer">
  <div class="footer-inner reveal">
    <div>
      <div class="footer-brand">woody<span class="nav-logo-dot"></span></div>
      <p class="footer-tagline">
        记录技术探索中的思考与感悟，<br />分享实用工具，沉淀体系化知识。
      </p>
    </div>
    <div>
      <h4 class="footer-col-title">内容</h4>
      <ul class="footer-links">
        <li><a href={base + '/articles/'} class="footer-link">全部文章</a></li>
        <li><a href={base + '/tools/'} class="footer-link">工具集合</a></li>
        <li><a href={base + '/tutorials/'} class="footer-link">教程系列</a></li>
      </ul>
    </div>
    <div>
      <h4 class="footer-col-title">关于</h4>
      <ul class="footer-links">
        <li><a href={base + '/articles/'} class="footer-link">关于本站</a></li>
        <li><a href={base + '/'} class="footer-link">回到首页</a></li>
      </ul>
    </div>
  </div>
  <div class="footer-bottom">
    <span>© {year} woody · All rights reserved</span>
    <div class="footer-socials">
      <a href="https://github.com/liangqiangWang" class="footer-social" aria-label="GitHub" target="_blank" rel="noopener">
        <Icons name="github" size={16} filled />
      </a>
      <a href="mailto:wangliangqiang1991@126.com" class="footer-social" aria-label="Email">
        <Icons name="mail" size={16} />
      </a>
    </div>
  </div>
</footer>
