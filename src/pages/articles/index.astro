---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { readTimeOf } from '../../lib/format';

const articles = (await getCollection('articles'))
  .filter((a) => !a.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .map((a) => ({
    ...a,
    data: {
      ...a.data,
      readTime: a.data.readTime ?? (a.body ? readTimeOf(a.body) : undefined),
    },
  }));
---
<BaseLayout title="全部文章" description="按时间倒序排列的思考与技术记录。" active="/articles/">
  <div class="container">
    <header class="page-header">
      <div class="page-header-label">Articles</div>
      <h1 class="page-header-title">全部文章</h1>
      <p class="page-header-desc">按时间倒序排列的思考与技术记录，点击阅读。</p>
    </header>

    {articles.length > 0 ? (
      <div class="article-list">
        {articles.map((a) => (
          <a href={`${import.meta.env.BASE_URL}articles/${a.id}/`} class="article-list-item">
            <div class="article-list-dot" style={`background: var(--accent)`}></div>
            <div class="article-list-body">
              <div class="article-list-meta">
                <span class="article-list-category">{a.data.category}</span>
                <span class="article-list-date">{a.data.date.getFullYear()}.{String(a.data.date.getMonth() + 1).padStart(2, '0')}.{String(a.data.date.getDate()).padStart(2, '0')}</span>
              </div>
              <h3 class="article-list-title">{a.data.title}</h3>
              <p class="article-list-excerpt">{a.data.desc}</p>
            </div>
          </a>
        ))}
      </div>
    ) : (
      <p class="empty-hint">还没有文章。</p>
    )}
  </div>
</BaseLayout>

<style>
  .article-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }

  .article-list-item {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1.5rem;
    align-items: center;
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--border-light);
    transition: all 0.3s var(--ease);
  }

  .article-list-item:hover {
    transform: translateX(8px);
    border-color: var(--border);
  }

  .article-list-item:hover .article-list-dot {
    transform: scale(1.3);
  }

  .article-list-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    transition: transform 0.3s var(--ease);
  }

  .article-list-body {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .article-list-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .article-list-category {
    font-weight: 600;
    color: var(--accent);
    letter-spacing: 0.03em;
  }

  .article-list-date {
    font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
  }

  .article-list-title {
    font-family: var(--font-serif);
    font-size: 1.2rem;
    font-weight: 600;
    line-height: 1.4;
    transition: color 0.3s var(--ease);
  }

  .article-list-item:hover .article-list-title {
    color: var(--accent);
  }

  .article-list-excerpt {
    font-size: 0.9rem;
    color: var(--text-sub);
    line-height: 1.7;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .empty-hint {
    text-align: center;
    color: var(--text-muted);
    padding: 4rem 0;
  }

  @media (max-width: 768px) {
    .article-list-item {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .article-list-dot {
      display: none;
    }
  }
</style>
