---
import BaseLayout from './BaseLayout.astro';
import Icons from '../components/Icons.astro';
import Toc from '../components/Toc.astro';
import { SITE } from '../consts';
import { isLanding, landingUrl, chapterUrl } from '../lib/tutorials';
import type { CollectionEntry } from 'astro:content';
import '../styles/article.css';
import '../styles/tutorial.css';

interface Props {
  entry: CollectionEntry<'tutorials'>;
  /** 落地页元信息条目 */
  landing: CollectionEntry<'tutorials'>;
  /** 本教程全部章节 */
  chapters: CollectionEntry<'tutorials'>[];
  headings?: { depth: number; slug: string; text: string }[];
  prev?: CollectionEntry<'tutorials'>;
  next?: CollectionEntry<'tutorials'>;
}

const { entry, landing, chapters, headings = [], prev, next } = Astro.props;
const name = entry.id.split('/')[0];
const base = SITE.base;
const isLandingPage = isLanding(entry.id);
const idx = chapters.findIndex((c) => c.id === entry.id);
const LEVEL_LABEL: Record<string, string> = {
  beginner: '入门',
  intermediate: '中级',
  advanced: '进阶',
};
const badgeClass = `badge-${landing.data.level}`;
const chapterNameOf = (c: CollectionEntry<'tutorials'>) => c.id.split('/')[1];
---
<BaseLayout
  title={entry.data.title}
  description={landing.data.desc || entry.data.title}
  active="/tutorials/"
>
  {isLandingPage ? (
    <article class="tutorial-landing">
      <div class="tutorial-landing-inner">
        <header class="tutorial-landing-header">
          <span class:list={['tutorial-badge', badgeClass, 'tutorial-landing-badge']}>
            {LEVEL_LABEL[landing.data.level]}
          </span>
          <h1 class="tutorial-landing-title">{landing.data.title}</h1>
          <p class="tutorial-landing-desc">{landing.data.desc}</p>
        </header>

        <div class="tutorial-landing-prose"><slot /></div>

        {chapters.length > 0 && (
          <ol class="tutorial-chapter-list">
            {chapters.map((c, i) => (
              <li class="tutorial-chapter-item">
                <a href={base + chapterUrl(name, chapterNameOf(c))}>
                  <span class="num">{String(i + 1).padStart(2, '0')}</span>
                  <span class="name">{c.data.title}</span>
                </a>
              </li>
            ))}
          </ol>
        )}

        {chapters[0] && (
          <a href={base + chapterUrl(name, chapterNameOf(chapters[0]))} class="tutorial-start-btn">
            开始学习 <Icons name="arrow-right" size={15} />
          </a>
        )}
      </div>
    </article>
  ) : (
    <article class="tutorial-page">
      <div class="tutorial-topbar">
        <a href={base + landingUrl(name)} class="tutorial-back">
          <Icons name="arrow-left" size={14} />{landing.data.title}
        </a>
      </div>

      <div class="tutorial-layout">
        <aside class="tutorial-sidebar">
          <div class="tutorial-sidebar-title"><Icons name="list" size={14} />本教程目录</div>
          <ol class="tutorial-chapters">
            {chapters.map((c, i) => (
              <li>
                <a
                  href={base + chapterUrl(name, chapterNameOf(c))}
                  class:list={['tutorial-chapter-link', { active: c.id === entry.id }]}
                >
                  <span class="tutorial-chapter-num">{String(i + 1).padStart(2, '0')}</span>
                  <span>{c.data.title}</span>
                </a>
              </li>
            ))}
          </ol>
        </aside>

        <div class="tutorial-main">
          <header class="tutorial-chapter-header">
            <div class="tutorial-chapter-label">第 {idx + 1} 章</div>
            <h1 class="tutorial-chapter-title">{entry.data.title}</h1>
          </header>

          <div class="article-prose"><slot /></div>

          {headings.length > 0 && <Toc headings={headings} />}

          {(prev || next) && (
            <nav class="tutorial-pagination">
              {prev && (
                <a href={base + chapterUrl(name, chapterNameOf(prev))} class="tutorial-pager prev">
                  <span class="tutorial-pager-label"><Icons name="arrow-left" size={12} />上一篇</span>
                  <span class="tutorial-pager-title">{prev.data.title}</span>
                </a>
              )}
              {next && (
                <a href={base + chapterUrl(name, chapterNameOf(next))} class="tutorial-pager next">
                  <span class="tutorial-pager-label">下一篇<Icons name="arrow-right" size={12} /></span>
                  <span class="tutorial-pager-title">{next.data.title}</span>
                </a>
              )}
            </nav>
          )}
        </div>
      </div>
    </article>
  )}
</BaseLayout>
